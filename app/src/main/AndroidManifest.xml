<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      蓝牙 / 定位权限已全部移除（2026-10-12 瘦身）。
      本 fork 控制的是 K90 Ultra/Max **内置风扇**，走 root sysfs，完全不走蓝牙：
        - BleManagerHolder.kt 构造的是 FanManager，CoolerBleManager 从未被实例化；
        - MainActivity 的 PermissionEffects 只申请 POST_NOTIFICATIONS
          （见 ui/MainActivity.kt:172-175 的说明）；
        - FanManager 恒定上报 permissionGranted/locationServiceEnabled/bluetoothOn = true。
      上游那些权限是给红魔外置散热器的 BLE 扫描用的，对本机型纯属多余，
      且会让用户在应用信息页看到一堆"位置/附近设备"权限而产生困惑。
    -->

    <!-- 前台服务（持续监控与自动调速） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 内置风扇控制既不是蓝牙设备连接，也不是媒体播放，用 specialUse。
         CONNECTED_DEVICE 声明已一并移除：它要求实际持有 BLUETOOTH_CONNECT，
         而本应用已不再申请任何蓝牙权限（CoolerService 也不再用该类型）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机自启（恢复自动模式服务） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".ColdFrontApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="ColdFront"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 自动模式前台服务 -->
        <service
            android:name=".service.CoolerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="internal_fan_control" />
        </service>

        <!-- 快捷设置磁贴：风扇总开关（全应用只保留这一个磁贴）。
             图标用五叶扇叶矢量图，label 与首页标题一致。 -->
        <service
            android:name=".service.SystemFanTileService"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_fan_five_blade"
            android:label="@string/tile_fan_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 开机自启接收器 -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
