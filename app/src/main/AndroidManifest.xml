<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 蓝牙：Android 11 及以下（API <= 30）旧权限 -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- 蓝牙：Android 12+（API >= 31）新权限。neverForLocation：扫描结果不依赖定位服务，
         否则系统把 BLE 结果当作位置数据，定位关闭时一个广播都不下发 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- BLE 扫描在 Android 11 及以下需要位置权限；部分 OEM ROM 在 12+ 也强制要求，保留可申请 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 要求 BLE 硬件 -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- 前台服务（持续监控与自动调速） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 内置风扇控制既不是蓝牙设备连接，也不是媒体播放，Android 14+ 只认 specialUse；
         保留 connectedDevice 声明会因缺少 BLUETOOTH_CONNECT 而 startForeground 失败 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机自启（恢复自动模式服务） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="ColdFront"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 自动模式前台服务 -->
        <service
            android:name=".service.CoolerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="internal_fan_control" />
        </service>

        <!-- 快捷设置磁贴：风扇总开关（全应用只保留这一个磁贴）。
             图标用五叶扇叶矢量图，label 与首页标题一致。 -->
        <service
            android:name=".service.SystemFanTileService"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_fan_five_blade"
            android:label="@string/tile_fan_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 开机自启接收器 -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
